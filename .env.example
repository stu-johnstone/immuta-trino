# ---------------------------------------------------------------------------
# Local Trino + Iceberg lab for Immuta integration testing.
#
# `make up` copies this file to `.env` if `.env` does not exist yet.
# `.env` is gitignored: keep tokens and local overrides there, not here.
# ---------------------------------------------------------------------------

# Trino version. Pinned on purpose: never use `latest`.
# This MUST match the Immuta Trino plugin version you install.
TRINO_VERSION=476

# Host port for the Trino HTTP endpoint. The container always listens on 8080.
TRINO_HTTP_PORT=8080

# Container memory limit for Trino. The official image sizes the JVM heap to
# 80% of this limit, so do not go below ~1g. Raise this (e.g. 4g) if you give
# your Docker VM more memory.
TRINO_MEMORY=1200m

# ---------------------------------------------------------------------------
# Apache Iceberg REST catalog (SQLite-backed, persisted to ./data/catalog).
# No PostgreSQL, no in-memory-only catalog.
# ---------------------------------------------------------------------------
ICEBERG_REST_VERSION=1.10.1
ICEBERG_REST_PORT=8181
ICEBERG_REST_MEMORY=512m

# ---------------------------------------------------------------------------
# cloudflared tunnel, so the Immuta SaaS tenant can reach this local Trino.
# ---------------------------------------------------------------------------
CLOUDFLARED_VERSION=2026.9.3

# Optional. Leave empty to use a throwaway Cloudflare quick tunnel, which
# needs no Cloudflare account and gets a random *.trycloudflare.com hostname.
# Set this to a named-tunnel token for a stable hostname.
TUNNEL_TOKEN=
